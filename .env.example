# Origins must match the browser URLs exactly; no trailing slash.
ADMIN_USER=admin
ADMIN_ORIGIN=http://localhost:8080
PUBLIC_URL=http://localhost:8081
BIND_ADDRESS=127.0.0.1
MAX_UPLOAD_BYTES=5242880
MAX_PAGES=500
# Development defaults; images.lock.env overrides these with real digests.
GO_IMAGE=cgr.dev/chainguard/go:latest-dev
STATIC_IMAGE=cgr.dev/chainguard/static:latest
NGINX_IMAGE=cgr.dev/chainguard/nginx:latest
